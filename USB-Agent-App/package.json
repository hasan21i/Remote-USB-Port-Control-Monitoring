{
  "name": "usb-agent-app",
  "version": "1.0.0",
  "description": "Smart Zero-Trust Peripheral Security USB Agent Desktop Application",
  "main": "main-updated.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "make-ico": "node scripts/make-icon.js",
    "electron-pack": "electron-builder",
    "preelectron-pack": "npm run build"
  },
  "keywords": [
    "usb",
    "monitoring",
    "agent",
    "remote",
    "control"
  ],
  "author": "Smart Zero-Trust Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "jimp": "^0.16.1",
    "png-to-ico": "^3.0.1",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "auto-launch": "^5.0.6",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.8",
    "js-yaml": "^4.1.0",
    "playwright": "^1.55.0",
    "public-ip": "^7.0.1",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.2",
    "react-scripts": "^5.0.1",
    "socket.io-client": "^4.8.1",
    "systeminformation": "^5.27.8",
    "usb": "^2.13.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "extraMetadata": {
      "main": "main-updated.js"
    },
    "appId": "com.smartzerotrust.peripheral",
    "productName": "Smart Zero-Trust Peripheral Security",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "build/**/*",
      "!dist",
      "!Release",
      "!backend",
      "!src/**/*.test.js",
      "!.vscode",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Zero-Trust Security"
    }
  }
}
